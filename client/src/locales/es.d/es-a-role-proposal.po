# needs-native-review: the role proposal and its door, 26 Nov 2026
msgctxt "open proposal decide: fromOutside"
msgid "Proposed through the village's public page. Adopted, they hold these roles from the season's first day."
msgstr "Propuesta a través de la página pública de la aldea. Si se adopta, ocupa estos roles desde el primer día de la temporada."

# needs-native-review: the role proposal and its door, 26 Nov 2026
msgctxt "open proposal decide: heading"
msgid "{who} proposes to hold {role} next season"
msgstr "{who} propone ocupar {role} la próxima temporada"

# needs-native-review: the role proposal and its door, 26 Nov 2026
msgctxt "open proposal decide: loadFailed"
msgid "The proposal did not load. Try again."
msgstr "La propuesta no cargó. Intente de nuevo."

# needs-native-review: the role proposal and its door, 26 Nov 2026
msgctxt "open proposal decide: wordsHeading"
msgid "In their words"
msgstr "En sus palabras"

# needs-native-review: the role proposal and its door, 26 Nov 2026
msgctxt "open proposal decide: membersOnly"
msgid "Members read role proposals."
msgstr "Los miembros leen las propuestas de roles."

# needs-native-review: the role proposal and its door, 26 Nov 2026
msgctxt "open proposal decide: invitationUsed"
msgid "They made their account with their invitation."
msgstr "Creó su cuenta con su invitación."

# needs-native-review: the role proposal and its door, 26 Nov 2026
msgctxt "open proposal decide: notAHolder"
msgid "Adopting or declining a proposal is for a live holder of the power to place people in roles."
msgstr "Adoptar o declinar una propuesta le corresponde a quien tiene hoy el poder de asignar personas a roles."

# needs-native-review: the role proposal and its door, 26 Nov 2026
msgctxt "open proposal decide: review.notInvitedNotEmailed"
msgid "Recorded as not invited."
msgstr "Registrada como no invitada."

# needs-native-review: the role proposal and its door, 26 Nov 2026
msgctxt "open proposal decide: heading"
msgid "Somebody proposes to hold {head} and {last} next season"
msgstr "Alguien propone ocupar {head} y {last} la próxima temporada"

# needs-native-review: the role proposal and its door, 26 Nov 2026
msgctxt "open proposal decide: aim"
msgid "Their aim for the season"
msgstr "Su propósito para la temporada"

# needs-native-review: the role proposal and its door, 26 Nov 2026
msgctxt "open proposal decide: conversationMissing"
msgid "The conversation with {role} is not written up yet."
msgstr "La conversación con {role} aún no está escrita."

# needs-native-review: the role proposal and its door, 26 Nov 2026
msgctxt "open proposal decide: a full role"
msgid "{name} has room for 2 people, and both places are filled"
msgstr "{name} tiene espacio para 2 personas, y ambos lugares están ocupados"

# needs-native-review: the role proposal and its door, 26 Nov 2026
msgctxt "open proposal decide: declinedNotEmailed"
msgid "Declined."
msgstr "Declinada."

# needs-native-review: the role proposal and its door, 26 Nov 2026
msgctxt "open proposal decide: review.notInvitedEmailed"
msgid "The not-invited letter went by email."
msgstr "La carta de no invitación salió por correo."

# needs-native-review: the role proposal and its door, 26 Nov 2026
msgctxt "open proposal decide: applies"
msgid "Somebody applies for {head} and {last}"
msgstr "Alguien solicita {head} y {last}"

# needs-native-review: the role proposal and its door, 26 Nov 2026
msgctxt "open proposal decide: rolesHeading"
msgid "The roles"
msgstr "Los roles"

# needs-native-review: the role proposal and its door, 26 Nov 2026
msgctxt "open proposal decide: applies"
msgid "{who} applies for {head} and {last}"
msgstr "{who} solicita {head} y {last}"

# needs-native-review: the role proposal and its door, 26 Nov 2026
msgctxt "open proposal decide: not sent"
msgid "Email is not set up yet, so nothing went out."
msgstr "El correo aún no está configurado, así que no salió nada."

# needs-native-review: the role proposal and its door, 26 Nov 2026
msgctxt "open proposal decide: reissuedEmailed"
msgid "It went to them by email."
msgstr "Le llegó por correo."

# needs-native-review: the role proposal and its door, 26 Nov 2026
msgctxt "open proposal decide: status.adopted"
msgid "Adopted"
msgstr "Adoptada"

# needs-native-review: the role proposal and its door, 26 Nov 2026
msgctxt "open proposal decide: appliedFromOutside"
msgid "Applied through the village's public page. Adopted, they begin with a first cycle together."
msgstr "Solicitó a través de la página pública de la aldea. Si se adopta, empieza con un primer ciclo juntos."

# needs-native-review: the role proposal and its door, 26 Nov 2026
msgctxt "open proposal decide: forWhenASeatOpens"
msgid "for when a place opens"
msgstr "para cuando se abra un lugar"

# needs-native-review: the role proposal and its door, 26 Nov 2026
msgctxt "open proposal decide: review.done"
msgid "Our review of this application is already answered."
msgstr "Nuestra revisión de esta solicitud ya tiene respuesta."

# needs-native-review: the role proposal and its door, 26 Nov 2026
msgctxt "open proposal decide: door"
msgid "Right now nobody holds the power to place people in roles, so this proposal waits here until somebody does."
msgstr "Ahora mismo nadie tiene el poder de asignar personas a roles, así que esta propuesta espera aquí hasta que alguien lo tenga."

# needs-native-review: the role proposal and its door, 26 Nov 2026
msgctxt "open proposal decide: applies"
msgid "{who} applies for a role"
msgstr "{who} solicita un rol"

# needs-native-review: the role proposal and its door, 26 Nov 2026
msgctxt "open proposal decide: heading"
msgid "{who} proposes to hold {head} and {last} this moon"
msgstr "{who} propone ocupar {head} y {last} esta luna"

# needs-native-review: the role proposal and its door, 26 Nov 2026
msgctxt "open proposal decide: not sent"
msgid "Their address was taken off, so nothing went out."
msgstr "Su dirección se quitó, así que no salió nada."

# needs-native-review: the role proposal and its door, 26 Nov 2026
msgctxt "open proposal decide: tooMany"
msgid "That is a lot of decisions in a few minutes. Wait a little and try again."
msgstr "Son muchas decisiones en pocos minutos. Espere un poco e intente de nuevo."

# needs-native-review: the role proposal and its door, 26 Nov 2026
msgctxt "open proposal decide: leftHeading"
msgid "Before you can adopt"
msgstr "Antes de poder adoptar"

# needs-native-review: the role proposal and its door, 26 Nov 2026
msgctxt "open proposal decide: status.withdrawn"
msgid "Withdrawn"
msgstr "Retirada"

# needs-native-review: the role proposal and its door, 26 Nov 2026
msgctxt "open proposal decide: heading"
msgid "{who} proposes to hold {head} and {last} next season"
msgstr "{who} propone ocupar {head} y {last} la próxima temporada"

# needs-native-review: the role proposal and its door, 26 Nov 2026
msgctxt "open proposal decide: review.notInvite"
msgid "Send the not-invited letter"
msgstr "Enviar la carta de no invitación"

# needs-native-review: the role proposal and its door, 26 Nov 2026
msgctxt "open proposal decide: reissuedNotEmailed"
msgid "Copy it below and send it to them yourself."
msgstr "Cópiela abajo y envíesela usted."

# needs-native-review: the role proposal and its door, 26 Nov 2026
msgctxt "open proposal decide: adoptedAccountMoon"
msgid "Adopted. That address already has an account here, so no invitation was needed: their roles start today, for this moon."
msgstr "Adoptada. Esa dirección ya tiene una cuenta aquí, así que no hizo falta invitación: sus roles empiezan hoy, para esta luna."

# needs-native-review: the role proposal and its door, 26 Nov 2026
msgctxt "open proposal decide: moonEnded"
msgid "The moon this was proposed for has ended. You can adopt it for the moon running now; the letter will say so."
msgstr "La luna para la que se propuso ya terminó. Puede adoptarla para la luna en curso; la carta lo dirá."
