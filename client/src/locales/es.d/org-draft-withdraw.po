# Withdrawing an org chart draft, and the warning when two open drafts change one role (26 Nov 2026).

# needs-native-review: review inbox, org chart draft, 2026-11-26
msgctxt "review inbox: an org chart draft"
msgid "Withdraw"
msgstr "Retirar"

# needs-native-review: review inbox, org chart draft, 2026-11-26
msgctxt "review inbox: an org chart draft"
msgid "Withdraw this draft? It is kept on record, and it can no longer be published. Nothing on the org chart changes."
msgstr "¿Retirar este borrador? Queda registrado y ya no se puede publicar. Nada cambia en el organigrama."

# needs-native-review: review inbox, org chart draft, 2026-11-26
msgctxt "review inbox: an org chart draft"
msgid "Yes, withdraw it"
msgstr "Sí, retirarlo"

# needs-native-review: review inbox, org chart draft, 2026-11-26
msgctxt "review inbox: an org chart draft"
msgid "Withdrawn. It can no longer be published."
msgstr "Retirado. Ya no se puede publicar."

# needs-native-review: review inbox, org chart draft, 2026-11-26
msgctxt "review inbox: an org chart draft"
msgid "{0, plural, one {Another open draft also changes this role. Read both before you publish, and withdraw the one that is out of date.} other {# other open drafts also change this role. Read them before you publish, and withdraw the ones that are out of date.}}"
msgstr "{0, plural, one {Otro borrador abierto también cambia este rol. Lee ambos antes de publicar y retira el que esté desactualizado.} other {Otros # borradores abiertos también cambian este rol. Léelos antes de publicar y retira los que estén desactualizados.}}"
