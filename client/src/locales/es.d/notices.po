# needs-native-review: the bell, 26 Nov 2026
#: client/src/lib/noticeKindWordsI18n.ts
msgctxt "the bell: why a notice of this kind matters, kind ballot_opened"
msgid "The village opened a vote and you are on the roll for it. Your answer counts toward the outcome."
msgstr "La aldea abrió una votación y usted está en el padrón. Su respuesta cuenta para el resultado."

# needs-native-review: the bell, 26 Nov 2026
#: client/src/lib/noticeKindWordsI18n.ts
msgctxt "the bell: several notices of one kind batched into a line, kind ballot_opened"
msgid "{n} votes opened, and you are on the roll for each one."
msgstr "Se abrieron {n} votaciones y usted está en el padrón de cada una."

# needs-native-review: the bell, 26 Nov 2026
#: client/src/lib/noticeKindWordsI18n.ts
msgctxt "the bell: why a notice of this kind matters, kind agent_full_access"
msgid "Full access for one role's agent was turned on or off. With it on, that role's agent can make admin changes and accept proposals for the role holder, each one carrying their approval."
msgstr "Se activó o desactivó el acceso total del agente de un rol. Activado, ese agente puede hacer cambios de administración y aceptar propuestas por quien tiene el rol, cada uno con su aprobación."

# needs-native-review: the bell, 26 Nov 2026
#: client/src/lib/noticeKindWordsI18n.ts
msgctxt "the bell: several notices of one kind batched into a line, kind agent_full_access"
msgid "{n} changes to the full access an agent holds."
msgstr "{n} cambios al acceso total de un agente."

# needs-native-review: the bell, 26 Nov 2026
#: client/src/lib/noticeKindWordsI18n.ts
msgctxt "the bell: why a notice of this kind matters, kind time_poll_open"
msgid "Pick the times you can make. The time with the most picks becomes the gathering's time."
msgstr "Elija los horarios en que puede asistir. El horario con más votos será la hora del encuentro."

# needs-native-review: the bell, 26 Nov 2026
#: client/src/lib/noticeKindWordsI18n.ts
msgctxt "the bell: several notices of one kind batched into a line, kind time_poll_open"
msgid "{n} gatherings are choosing a time."
msgstr "{n} encuentros están eligiendo horario."

# needs-native-review: the bell, 26 Nov 2026
#: client/src/lib/noticeKindWordsI18n.ts
msgctxt "the bell: why a notice of this kind matters, kind change_request_review"
msgid "A change request touches what your role looks after. Ask, raise a concern or an objection, suggest an edit, or say you can live with it."
msgstr "Una solicitud de cambio toca lo que cuida su rol. Pregunte, plantee una inquietud o una objeción, sugiera una edición, o diga que puede vivir con ella."

# needs-native-review: the bell, 26 Nov 2026
#: client/src/lib/noticeKindWordsI18n.ts
msgctxt "the bell: several notices of one kind batched into a line, kind change_request_review"
msgid "{n} change requests are asking for your review."
msgstr "{n} solicitudes de cambio piden su revisión."

# needs-native-review: the bell, 26 Nov 2026
#: client/src/lib/noticeKindWordsI18n.ts
msgctxt "the bell: why a notice of this kind matters, kind change_request"
msgid "Something new on a change request you are part of. Open it to read and answer."
msgstr "Hay algo nuevo en una solicitud de cambio en la que usted participa. Ábrala para leer y responder."

# needs-native-review: the bell, 26 Nov 2026
#: client/src/lib/noticeKindWordsI18n.ts
msgctxt "the bell: several notices of one kind batched into a line, kind change_request"
msgid "{n} updates on change requests you are part of."
msgstr "{n} novedades en solicitudes de cambio en las que participa."

# needs-native-review: the bell, 26 Nov 2026
#: client/src/lib/noticeKindWordsI18n.ts
msgctxt "the bell: why a notice of this kind matters, kind ballot_closing"
msgid "The window is closing and your vote is still owed. Quorum is measured against everyone on the roll."
msgstr "El plazo está por cerrar y su voto sigue pendiente. El quórum se mide contra todo el padrón."

# needs-native-review: the bell, 26 Nov 2026
#: client/src/lib/noticeKindWordsI18n.ts
msgctxt "the bell: several notices of one kind batched into a line, kind ballot_closing"
msgid "{n} votes close soon and are still waiting on your answer."
msgstr "{n} votaciones cierran pronto y siguen esperando su respuesta."

# needs-native-review: the bell, 26 Nov 2026
#: client/src/lib/noticeKindWordsI18n.ts
msgctxt "the bell: why a notice of this kind matters, kind ballot_carried"
msgid "The village said yes. What was voted on now applies, and the closer wrote down why."
msgstr "La aldea dijo que sí. Lo votado ya aplica, y quien cerró la votación dejó escrito por qué."

# needs-native-review: the bell, 26 Nov 2026
#: client/src/lib/noticeKindWordsI18n.ts
msgctxt "the bell: several notices of one kind batched into a line, kind ballot_carried"
msgid "{n} votes carried."
msgstr "{n} votaciones aprobadas."

# needs-native-review: the bell, 26 Nov 2026
#: client/src/lib/noticeKindWordsI18n.ts
msgctxt "the bell: why a notice of this kind matters, kind ballot_not_yet_in_effect"
msgid "The village said yes and the decision has not taken effect yet. The decision page says what happens next."
msgstr "La aldea dijo que sí y la decisión todavía no entra en vigor. La página de la decisión explica qué sigue."

# needs-native-review: the bell, 26 Nov 2026
#: client/src/lib/noticeKindWordsI18n.ts
msgctxt "the bell: several notices of one kind batched into a line, kind ballot_not_yet_in_effect"
msgid "{n} carried votes have not taken effect yet."
msgstr "{n} votaciones aprobadas todavía no entran en vigor."

# needs-native-review: the bell, 26 Nov 2026
#: client/src/lib/noticeKindWordsI18n.ts
msgctxt "the bell: why a notice of this kind matters, kind ballot_failed"
msgid "The village said no. The closer wrote down the reasoning, and it stands on the record."
msgstr "La aldea dijo que no. Quien cerró la votación dejó escrito el razonamiento, y queda en el registro."

# needs-native-review: the bell, 26 Nov 2026
#: client/src/lib/noticeKindWordsI18n.ts
msgctxt "the bell: several notices of one kind batched into a line, kind ballot_failed"
msgid "{n} votes closed without passing."
msgstr "{n} votaciones cerraron sin aprobarse."

# needs-native-review: the bell, 26 Nov 2026
#: client/src/lib/noticeKindWordsI18n.ts
msgctxt "the bell: why a notice of this kind matters, kind ballot_no_quorum"
msgid "Too few of the roll answered for this to settle anything. The question stands, and it can be asked again."
msgstr "Respondieron muy pocas personas del padrón para resolver algo. La pregunta sigue en pie y se puede volver a hacer."

# needs-native-review: the bell, 26 Nov 2026
#: client/src/lib/noticeKindWordsI18n.ts
msgctxt "the bell: several notices of one kind batched into a line, kind ballot_no_quorum"
msgid "{n} votes closed with too few answering to settle them."
msgstr "{n} votaciones cerraron con muy pocas respuestas para resolverse."

# needs-native-review: the bell, 26 Nov 2026
#: client/src/lib/noticeKindWordsI18n.ts
msgctxt "the bell: why a notice of this kind matters, kind ballot_rerun_opened"
msgid "Too few answered a vote you are on the roll for, so it is open again for as long as before, and half as many voices are enough this time."
msgstr "Muy pocas personas respondieron una votación en cuyo padrón usted está, así que se abre de nuevo por el mismo tiempo, y esta vez basta con la mitad de las voces."

# needs-native-review: the bell, 26 Nov 2026
#: client/src/lib/noticeKindWordsI18n.ts
msgctxt "the bell: several notices of one kind batched into a line, kind ballot_rerun_opened"
msgid "{n} votes are open again with too few having answered."
msgstr "{n} votaciones se abrieron de nuevo por falta de respuestas."

# needs-native-review: the bell, 26 Nov 2026
#: client/src/lib/noticeKindWordsI18n.ts
msgctxt "the bell: why a notice of this kind matters, kind ballot_withdrawn"
msgid "A vote you were on the roll for was called off before it closed. Nothing was decided, and the reason is on the record."
msgstr "Una votación en cuyo padrón usted estaba se canceló antes de cerrar. No se decidió nada, y el motivo queda en el registro."

# needs-native-review: the bell, 26 Nov 2026
#: client/src/lib/noticeKindWordsI18n.ts
msgctxt "the bell: several notices of one kind batched into a line, kind ballot_withdrawn"
msgid "{n} votes were called off."
msgstr "Se cancelaron {n} votaciones."

# needs-native-review: the bell, 26 Nov 2026
#: client/src/lib/noticeKindWordsI18n.ts
msgctxt "the bell: why a notice of this kind matters, kind ballot_advisory_closed"
msgid "An advisory vote closed. It records what the village would decide, and nothing changed on its own."
msgstr "Cerró una votación consultiva. Registra lo que la aldea decidiría, y nada cambió por sí solo."

# needs-native-review: the bell, 26 Nov 2026
#: client/src/lib/noticeKindWordsI18n.ts
msgctxt "the bell: several notices of one kind batched into a line, kind ballot_advisory_closed"
msgid "{n} advisory votes closed."
msgstr "Cerraron {n} votaciones consultivas."

# needs-native-review: the bell, 26 Nov 2026
#: client/src/lib/noticeKindWordsI18n.ts
msgctxt "the bell: why a notice of this kind matters, kind ballot_vetoed"
msgid "A steward stopped a decision the village carried, inside its window, and said why."
msgstr "Una persona custodia detuvo una decisión que la aldea aprobó, dentro de su plazo, y explicó por qué."

# needs-native-review: the bell, 26 Nov 2026
#: client/src/lib/noticeKindWordsI18n.ts
msgctxt "the bell: several notices of one kind batched into a line, kind ballot_vetoed"
msgid "{n} decisions were stopped, each with a reason."
msgstr "Se detuvieron {n} decisiones, cada una con su motivo."

# needs-native-review: the bell, 26 Nov 2026
#: client/src/lib/noticeKindWordsI18n.ts
msgctxt "the bell: why a notice of this kind matters, kind veto_window_opened"
msgid "The village carried a decision and your window to stop it is open. The page names the instant it lands."
msgstr "La aldea aprobó una decisión y su plazo para detenerla está abierto. La página indica el momento exacto en que entra en vigor."

# needs-native-review: the bell, 26 Nov 2026
#: client/src/lib/noticeKindWordsI18n.ts
msgctxt "the bell: several notices of one kind batched into a line, kind veto_window_opened"
msgid "{n} carried decisions are inside their window."
msgstr "{n} decisiones aprobadas están dentro de su plazo."

# needs-native-review: the bell, 26 Nov 2026
#: client/src/lib/noticeKindWordsI18n.ts
msgctxt "the bell: why a notice of this kind matters, kind veto_window_halfway"
msgid "Half of your window to stop a carried decision has gone. It lands at its instant unless somebody stops it."
msgstr "Ya pasó la mitad de su plazo para detener una decisión aprobada. Entra en vigor a su hora salvo que alguien la detenga."

# needs-native-review: the bell, 26 Nov 2026
#: client/src/lib/noticeKindWordsI18n.ts
msgctxt "the bell: several notices of one kind batched into a line, kind veto_window_halfway"
msgid "{n} windows are half gone."
msgstr "{n} plazos ya van por la mitad."

# needs-native-review: the bell, 26 Nov 2026
#: client/src/lib/noticeKindWordsI18n.ts
msgctxt "the bell: why a notice of this kind matters, kind veto_window_closing"
msgid "Two hours left to stop a carried decision. After that it lands and the door is closed."
msgstr "Quedan dos horas para detener una decisión aprobada. Después entra en vigor y ya no hay vuelta atrás."

# needs-native-review: the bell, 26 Nov 2026
#: client/src/lib/noticeKindWordsI18n.ts
msgctxt "the bell: several notices of one kind batched into a line, kind veto_window_closing"
msgid "{n} windows close within two hours."
msgstr "{n} plazos cierran en menos de dos horas."

# needs-native-review: the bell, 26 Nov 2026
#: client/src/lib/noticeKindWordsI18n.ts
msgctxt "the bell: why a notice of this kind matters, kind ballot_expired"
msgid "A voting window ran out with nobody closing it. Closing is a human act, so the ballot waits for one."
msgstr "El plazo de una votación venció sin que nadie la cerrara. Cerrarla es un acto humano, así que la votación espera a una persona."

# needs-native-review: the bell, 26 Nov 2026
#: client/src/lib/noticeKindWordsI18n.ts
msgctxt "the bell: several notices of one kind batched into a line, kind ballot_expired"
msgid "{n} votes are past their window and waiting for someone to close them."
msgstr "{n} votaciones vencieron y esperan que alguien las cierre."

# needs-native-review: the bell, 26 Nov 2026
#: client/src/lib/noticeKindWordsI18n.ts
msgctxt "the bell: why a notice of this kind matters, kind governance"
msgid "A proposal you raised, or one the village is carrying, moved a step."
msgstr "Una propuesta que usted planteó, o una que la aldea está llevando, avanzó un paso."

# needs-native-review: the bell, 26 Nov 2026
#: client/src/lib/noticeKindWordsI18n.ts
msgctxt "the bell: several notices of one kind batched into a line, kind governance"
msgid "{n} proposals moved."
msgstr "{n} propuestas avanzaron."

# needs-native-review: the bell, 26 Nov 2026
#: client/src/lib/noticeKindWordsI18n.ts
msgctxt "the bell: why a notice of this kind matters, kind seat_application_reminder"
msgid "An application for a role still waits on a role holder, and you hold that power."
msgstr "Una solicitud para un rol todavía espera a quien tiene el rol, y usted tiene esa facultad."

# needs-native-review: the bell, 26 Nov 2026
#: client/src/lib/noticeKindWordsI18n.ts
msgctxt "the bell: several notices of one kind batched into a line, kind seat_application_reminder"
msgid "{n} applications still wait on a role holder."
msgstr "{n} solicitudes todavía esperan a quien tiene el rol."

# needs-native-review: the bell, 26 Nov 2026
#: client/src/lib/noticeKindWordsI18n.ts
msgctxt "the bell: why a notice of this kind matters, kind ask"
msgid "Someone asked you to do something, or answered something you asked."
msgstr "Alguien le pidió hacer algo, o respondió algo que usted pidió."

# needs-native-review: the bell, 26 Nov 2026
#: client/src/lib/noticeKindWordsI18n.ts
msgctxt "the bell: several notices of one kind batched into a line, kind ask"
msgid "{n} asks moved."
msgstr "{n} pedidos avanzaron."

# needs-native-review: the bell, 26 Nov 2026
#: client/src/lib/noticeKindWordsI18n.ts
msgctxt "the bell: why a notice of this kind matters, kind weight_changed"
msgid "How much your vote weighs was changed, and whoever changed it said why."
msgstr "Cambió el peso de su voto, y quien lo cambió explicó por qué."

# needs-native-review: the bell, 26 Nov 2026
#: client/src/lib/noticeKindWordsI18n.ts
msgctxt "the bell: several notices of one kind batched into a line, kind weight_changed"
msgid "{n} changes to how much your vote weighs."
msgstr "{n} cambios en el peso de su voto."

# needs-native-review: the bell, 26 Nov 2026
#: client/src/lib/noticeKindWordsI18n.ts
msgctxt "the bell: why a notice of this kind matters, kind role_appointed"
msgid "A role is yours to hold. The role page says what it is accountable for."
msgstr "Ahora usted tiene un rol. La página del rol dice de qué responde."

# needs-native-review: the bell, 26 Nov 2026
#: client/src/lib/noticeKindWordsI18n.ts
msgctxt "the bell: several notices of one kind batched into a line, kind role_appointed"
msgid "{n} roles came to you."
msgstr "Le asignaron {n} roles."

# needs-native-review: the bell, 26 Nov 2026
#: client/src/lib/noticeKindWordsI18n.ts
msgctxt "the bell: why a notice of this kind matters, kind season"
msgid "No season is running, so the calendar every term is measured against has stopped. Every mandate in the village hangs on it, the steward role included, so it says so until somebody starts the next one."
msgstr "No hay ninguna temporada en curso, así que se detuvo el calendario con que se mide cada periodo. Todos los mandatos de la aldea dependen de él, incluido el rol de custodio, y este aviso sigue hasta que alguien inicie la próxima."

# needs-native-review: the bell, 26 Nov 2026
#: client/src/lib/noticeKindWordsI18n.ts
msgctxt "the bell: several notices of one kind batched into a line, kind season"
msgid "The calendar has been stopped for {n} sweeps."
msgstr "El calendario lleva {n} revisiones detenido."

# needs-native-review: the bell, 26 Nov 2026
#: client/src/lib/noticeKindWordsI18n.ts
msgctxt "the bell: why a notice of this kind matters, kind season_ending"
msgid "The season turns soon. Before it does, the village records what this season did and seats people for the next one, so the reminders start two weeks out."
msgstr "La temporada cambia pronto. Antes, la aldea registra lo que hizo esta temporada y asigna puestos para la próxima, por eso los recordatorios empiezan dos semanas antes."

# needs-native-review: the bell, 26 Nov 2026
#: client/src/lib/noticeKindWordsI18n.ts
msgctxt "the bell: several notices of one kind batched into a line, kind season_ending"
msgid "{n} reminders that the season is turning."
msgstr "{n} recordatorios de que la temporada está por cambiar."

# needs-native-review: the bell, 26 Nov 2026
#: client/src/lib/noticeKindWordsI18n.ts
msgctxt "the bell: why a notice of this kind matters, kind season_plan_open"
msgid "Planning is open for the season. Choose the roles you keep, hand back or apply for, and what you will do."
msgstr "La planificación de la temporada está abierta. Elija los roles que mantiene, devuelve o solicita, y lo que va a hacer."

# needs-native-review: the bell, 26 Nov 2026
#: client/src/lib/noticeKindWordsI18n.ts
msgctxt "the bell: several notices of one kind batched into a line, kind season_plan_open"
msgid "{n} notices that planning is open."
msgstr "{n} avisos de que la planificación está abierta."

# needs-native-review: the bell, 26 Nov 2026
#: client/src/lib/noticeKindWordsI18n.ts
msgctxt "the bell: why a notice of this kind matters, kind season_plan_reminder"
msgid "Your season plan is not filed yet. Filing takes a few minutes, and the village sees it by name."
msgstr "Su plan de temporada todavía no está presentado. Toma unos minutos, y la aldea lo ve con su nombre."

# needs-native-review: the bell, 26 Nov 2026
#: client/src/lib/noticeKindWordsI18n.ts
msgctxt "the bell: several notices of one kind batched into a line, kind season_plan_reminder"
msgid "{n} reminders to file your season."
msgstr "{n} recordatorios para presentar su plan de temporada."

# needs-native-review: the bell, 26 Nov 2026
#: client/src/lib/noticeKindWordsI18n.ts
msgctxt "the bell: why a notice of this kind matters, kind role_proposal_feedback"
msgid "A member who has the link to your role proposal left feedback on it. Open the draft to read it."
msgstr "Una persona con el enlace a su propuesta de rol dejó comentarios. Abra el borrador para leerlos."

# needs-native-review: the bell, 26 Nov 2026
#: client/src/lib/noticeKindWordsI18n.ts
msgctxt "the bell: several notices of one kind batched into a line, kind role_proposal_feedback"
msgid "{n} pieces of feedback on your role proposal."
msgstr "{n} comentarios sobre su propuesta de rol."

# needs-native-review: the bell, 26 Nov 2026
#: client/src/lib/noticeKindWordsI18n.ts
msgctxt "the bell: why a notice of this kind matters, kind role_proposal_consent_ask"
msgid "A member proposes roles in a circle you hold a role in. Consent or object within 2 business days."
msgstr "Alguien propone roles en un círculo donde usted tiene un rol. Dé su consentimiento u objete en 2 días hábiles."

# needs-native-review: the bell, 26 Nov 2026
#: client/src/lib/noticeKindWordsI18n.ts
msgctxt "the bell: several notices of one kind batched into a line, kind role_proposal_consent_ask"
msgid "{n} role proposals ask your circle to consent."
msgstr "{n} propuestas de rol piden el consentimiento de su círculo."

# needs-native-review: the bell, 26 Nov 2026
#: client/src/lib/noticeKindWordsI18n.ts
msgctxt "the bell: why a notice of this kind matters, kind role_proposal_objection"
msgid "A member of the circle objected to your role proposal, so it goes to the circle's next meeting."
msgstr "Alguien del círculo objetó su propuesta de rol, así que pasa a la próxima reunión del círculo."

# needs-native-review: the bell, 26 Nov 2026
#: client/src/lib/noticeKindWordsI18n.ts
msgctxt "the bell: several notices of one kind batched into a line, kind role_proposal_objection"
msgid "{n} objections to your role proposals."
msgstr "{n} objeciones a sus propuestas de rol."

# needs-native-review: the bell, 26 Nov 2026
#: client/src/lib/noticeKindWordsI18n.ts
msgctxt "the bell: why a notice of this kind matters, kind open_role_proposal_consent_ask"
msgid "Somebody from outside the village proposes to hold roles in a circle you hold a role in. Consent or object within 2 business days."
msgstr "Una persona de fuera de la aldea propone asumir roles en un círculo donde usted tiene un rol. Dé su consentimiento u objete en 2 días hábiles."

# needs-native-review: the bell, 26 Nov 2026
#: client/src/lib/noticeKindWordsI18n.ts
msgctxt "the bell: several notices of one kind batched into a line, kind open_role_proposal_consent_ask"
msgid "{n} role proposals from outside the village ask your circle to consent."
msgstr "{n} propuestas de rol de fuera de la aldea piden el consentimiento de su círculo."

# needs-native-review: the bell, 26 Nov 2026
#: client/src/lib/noticeKindWordsI18n.ts
msgctxt "the bell: why a notice of this kind matters, kind open_role_proposal_decided"
msgid "The village answered a proposal for an agent you keep: seated on its roles, or declined."
msgstr "La aldea respondió una propuesta para un agente a su cargo: asignado a sus roles, o rechazado."

# needs-native-review: the bell, 26 Nov 2026
#: client/src/lib/noticeKindWordsI18n.ts
msgctxt "the bell: several notices of one kind batched into a line, kind open_role_proposal_decided"
msgid "{n} answers on proposals for agents you keep."
msgstr "{n} respuestas sobre propuestas para agentes a su cargo."

# needs-native-review: the bell, 26 Nov 2026
#: client/src/lib/noticeKindWordsI18n.ts
msgctxt "the bell: why a notice of this kind matters, kind applicant_update"
msgid "An update about a role you proposed to hold: a reply, a conversation, the circle weighing it, or the answer."
msgstr "Novedades sobre un rol que usted propuso asumir: una respuesta, una conversación, el círculo valorándolo, o la decisión."

# needs-native-review: the bell, 26 Nov 2026
#: client/src/lib/noticeKindWordsI18n.ts
msgctxt "the bell: several notices of one kind batched into a line, kind applicant_update"
msgid "{n} updates about your role proposals."
msgstr "{n} novedades sobre sus propuestas de rol."

# needs-native-review: the bell, 26 Nov 2026
#: client/src/lib/noticeKindWordsI18n.ts
msgctxt "the bell: why a notice of this kind matters, kind open_role_proposal_waiting"
msgid "Somebody from outside the village proposes to hold roles. You hold the power to place people in roles, so it is yours to adopt or decline."
msgstr "Una persona de fuera de la aldea propone asumir roles. Usted tiene la facultad de asignar roles, así que le toca aceptarla o rechazarla."

# needs-native-review: the bell, 26 Nov 2026
#: client/src/lib/noticeKindWordsI18n.ts
msgctxt "the bell: several notices of one kind batched into a line, kind open_role_proposal_waiting"
msgid "{n} role proposals from outside the village wait on you."
msgstr "{n} propuestas de rol de fuera de la aldea esperan su respuesta."

# needs-native-review: the bell, 26 Nov 2026
#: client/src/lib/noticeKindWordsI18n.ts
msgctxt "the bell: why a notice of this kind matters, kind application_interview_turn"
msgid "An applicant is waiting to talk with a role you hold. Book the conversation, then write your scorecard alone."
msgstr "Una persona solicitante espera conversar con un rol que usted tiene. Agende la conversación y luego llene su evaluación por su cuenta."

# needs-native-review: the bell, 26 Nov 2026
#: client/src/lib/noticeKindWordsI18n.ts
msgctxt "the bell: several notices of one kind batched into a line, kind application_interview_turn"
msgid "{n} applicants wait to talk with you."
msgstr "{n} solicitantes esperan conversar con usted."

# needs-native-review: the bell, 26 Nov 2026
#: client/src/lib/noticeKindWordsI18n.ts
msgctxt "the bell: why a notice of this kind matters, kind application_arrived"
msgid "An application arrived for a role in a circle you hold a role in. You are asked to consent after the conversations."
msgstr "Llegó una solicitud para un rol en un círculo donde usted tiene un rol. Se le pedirá su consentimiento después de las conversaciones."

# needs-native-review: the bell, 26 Nov 2026
#: client/src/lib/noticeKindWordsI18n.ts
msgctxt "the bell: several notices of one kind batched into a line, kind application_arrived"
msgid "{n} applications arrived in your circles."
msgstr "Llegaron {n} solicitudes a sus círculos."

# needs-native-review: the bell, 26 Nov 2026
#: client/src/lib/noticeKindWordsI18n.ts
msgctxt "the bell: why a notice of this kind matters, kind application_first_reply_due"
msgid "An applicant is owed a first reply within 3 business days."
msgstr "Una persona solicitante debe recibir una primera respuesta en 3 días hábiles."

# needs-native-review: the bell, 26 Nov 2026
#: client/src/lib/noticeKindWordsI18n.ts
msgctxt "the bell: several notices of one kind batched into a line, kind application_first_reply_due"
msgid "{n} applicants are owed a first reply."
msgstr "{n} solicitantes esperan una primera respuesta."

# needs-native-review: the bell, 26 Nov 2026
#: client/src/lib/noticeKindWordsI18n.ts
msgctxt "the bell: why a notice of this kind matters, kind application_stale"
msgid "An application has not moved for ten days. A person decides what happens next."
msgstr "Una solicitud lleva diez días sin moverse. Una persona decide qué sigue."

