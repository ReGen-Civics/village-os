# needs-native-review: module menu names and places, 27 Nov 2026
#: client/src/components/admin/ModuleMenuFields.tsx
msgctxt "module menu place: the account menu as a place"
msgid "Your account menu"
msgstr "El menú de su cuenta"

# needs-native-review: module menu names and places, 27 Nov 2026
#: client/src/components/admin/ModuleMenuFields.tsx
msgctxt "module menu place: a group would be too long"
msgid "{group} would show {count} rows once every module is on, and it shows {max} at most. Choose one of its folders, or another group."
msgstr "{group} mostraría {count} filas con todos los módulos activados, y muestra {max} como máximo. Elija una de sus carpetas u otro grupo."

# needs-native-review: module menu names and places, 27 Nov 2026
#: client/src/components/admin/ModuleMenuFields.tsx
msgctxt "module menu place: a folder would be too full"
msgid "The {folder} folder would hold {count} entries once every module is on, and a folder holds {FOLDER_MAX} at most. Choose another folder, or a row of its own."
msgstr "La carpeta {folder} tendría {count} entradas con todos los módulos activados, y una carpeta tiene {FOLDER_MAX} como máximo. Elija otra carpeta, o una fila propia."

# needs-native-review: module menu names and places, 27 Nov 2026
#: client/src/components/admin/ModuleMenuFields.tsx
msgctxt "module menu place: below the Module Library"
msgid "The Module Library stays at the bottom of the menu. Choose a place above it."
msgstr "La Biblioteca de módulos se queda al final del menú. Elija un lugar por encima de ella."

# needs-native-review: module menu names and places, 27 Nov 2026
#: client/src/components/admin/ModuleMenuFields.tsx
msgctxt "module menu place: the entry's name field"
msgid "In the menu as"
msgstr "En el menú como"

# needs-native-review: module menu names and places, 27 Nov 2026
#: client/src/components/admin/ModuleMenuFields.tsx
msgctxt "module menu place: the group or folder picker"
msgid "Where"
msgstr "Dónde"

# needs-native-review: module menu names and places, 27 Nov 2026
#: client/src/components/admin/ModuleMenuFields.tsx
msgctxt "module menu place: a group, not in a folder"
msgid "{group}, a row of its own"
msgstr "{group}, en una fila propia"

# needs-native-review: module menu names and places, 27 Nov 2026
#: client/src/components/admin/ModuleMenuFields.tsx
msgctxt "module menu place: the position picker"
msgid "Position"
msgstr "Posición"

# needs-native-review: module menu names and places, 27 Nov 2026
