# needs-native-review: module menu names and places, 27 Nov 2026
#: client/src/components/admin/MenuPlaceStep.tsx
msgctxt "module menu place: the account menu, mid-sentence"
msgid "your account menu"
msgstr "el menú de su cuenta"

# needs-native-review: module menu names and places, 27 Nov 2026
#: client/src/components/admin/MenuPlaceStep.tsx
msgctxt "module menu place: where a module's entry will appear, read-only"
msgid "In the menu as {name}, in {where}."
msgstr "En el menú como {name}, en {where}."

# needs-native-review: module menu names and places, 27 Nov 2026
#: client/src/components/admin/MenuPlaceStep.tsx
msgctxt "module menu place: changing it later"
msgid "Once it is on, the village can rename it or move it in Admin, Menu."
msgstr "Una vez activado, la aldea puede cambiarle el nombre o moverlo en Administración, Menú."

# needs-native-review: module menu names and places, 27 Nov 2026
#: client/src/components/admin/MenuPlaceStep.tsx
msgctxt "module menu place: the turn-on step's heading"
msgid "In the menu"
msgstr "En el menú"

# needs-native-review: module menu names and places, 27 Nov 2026
#: client/src/components/admin/MenuPlaceStep.tsx
msgctxt "module menu place: the turn-on step, explained"
msgid "Its name and where it shows. Keep them, or make them the village's own. You can change both later in Admin, Menu."
msgstr "Su nombre y dónde aparece. Consérvelos, o hágalos propios de la aldea. Puede cambiar ambos más tarde en Administración, Menú."

# needs-native-review: module menu names and places, 27 Nov 2026
#: client/src/components/admin/ModuleMenuList.tsx
msgctxt "admin menu: the modules' own menu entries"
msgid "Module entries"
msgstr "Entradas de módulos"

# needs-native-review: module menu names and places, 27 Nov 2026
#: client/src/components/admin/ModuleMenuList.tsx
msgctxt "admin menu: the module entries, explained"
msgid "Each module brings its own entry. Name it and choose where it sits: a group, a folder in it, and its place among the rows. The preview shows the group as members will meet it. Blank keeps the module's own name."
msgstr "Cada módulo trae su propia entrada. Póngale nombre y elija dónde va: un grupo, una carpeta dentro de él y su lugar entre las filas. La vista previa muestra el grupo como lo verán los miembros. En blanco se usa el nombre propio del módulo."

# needs-native-review: module menu names and places, 27 Nov 2026
#: client/src/components/admin/ModuleMenuList.tsx
msgctxt "admin menu: a module entry whose module is off"
msgid "Module off"
msgstr "Módulo desactivado"

