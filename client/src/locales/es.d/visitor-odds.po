# needs-native-review: visitor pages, 26 Nov 2026
msgctxt "work with us: an error"
msgid "Add your name and email so we know who we're speaking with."
msgstr "Agregue su nombre y correo para saber con quién hablamos."

# needs-native-review: visitor pages, 26 Nov 2026
msgctxt "work with us: an error"
msgid "Choose at least one form of reciprocity that fits."
msgstr "Elija al menos una forma de reciprocidad que encaje."

# needs-native-review: visitor pages, 26 Nov 2026
msgctxt "work with us: an error"
msgid "That didn't send. Try again."
msgstr "No se envió. Intente de nuevo."

# needs-native-review: visitor pages, 26 Nov 2026
msgctxt "work with us: an error"
msgid "That file didn't attach. Try again."
msgstr "El archivo no se adjuntó. Intente de nuevo."

# needs-native-review: visitor pages, 26 Nov 2026
msgctxt "work with us: an error naming the question left blank"
msgid "Answer this to continue: {0}."
msgstr "Responda esto para continuar: {0}."

# needs-native-review: visitor pages, 26 Nov 2026
msgctxt "work with us: a question"
msgid "The work"
msgstr "El trabajo"

# needs-native-review: visitor pages, 26 Nov 2026
msgctxt "work with us: help under a question"
msgid "Describe what you're proposing, in plain terms. What is it?"
msgstr "Describa lo que propone, en palabras sencillas. ¿Qué es?"

# needs-native-review: visitor pages, 26 Nov 2026
msgctxt "work with us: a question"
msgid "How it serves the community"
msgstr "Cómo sirve a la comunidad"

# needs-native-review: visitor pages, 26 Nov 2026
msgctxt "work with us: help under a question"
msgid "How would this serve the community, the land, the guests, the ecosystem, or the mission?"
msgstr "¿Cómo serviría esto a la comunidad, la tierra, las personas visitantes, el ecosistema o la misión?"

# needs-native-review: visitor pages, 26 Nov 2026
msgctxt "work with us: a question"
msgid "Cost of materials"
msgstr "Costo de materiales"

# needs-native-review: visitor pages, 26 Nov 2026
msgctxt "work with us: help under a question"
msgid "What materials, supplies, or inputs are required, and what do they cost? Note anything the village may already have."
msgstr "¿Qué materiales, suministros o insumos se necesitan, y cuánto cuestan? Anote lo que la aldea ya podría tener."

# needs-native-review: visitor pages, 26 Nov 2026
msgctxt "work with us: a question"
msgid "Time to implement"
msgstr "Tiempo de ejecución"

# needs-native-review: visitor pages, 26 Nov 2026
msgctxt "work with us: help under a question"
msgid "How long from approval to completion? Note any phases, seasonality, or dependencies."
msgstr "¿Cuánto tiempo desde la aprobación hasta terminar? Anote fases, temporadas o dependencias."

# needs-native-review: visitor pages, 26 Nov 2026
msgctxt "work with us: a question"
msgid "What you'd need from us"
msgstr "Lo que necesitaría de nosotros"

# needs-native-review: visitor pages, 26 Nov 2026
msgctxt "work with us: help under a question"
msgid "Information or access, decisions and by when, meeting time, site access, utilities, equipment, or labor."
msgstr "Información o acceso, decisiones y para cuándo, tiempo de reunión, acceso al sitio, servicios, equipo o mano de obra."

# needs-native-review: visitor pages, 26 Nov 2026
msgctxt "work with us: a question"
msgid "Maintenance & longevity"
msgstr "Mantenimiento y duración"

# needs-native-review: visitor pages, 26 Nov 2026
msgctxt "work with us: help under a question"
msgid "What keeps it alive and well? Ongoing care, who's responsible, cost over time, expected lifespan."
msgstr "¿Qué lo mantiene vivo y en buen estado? Cuidado continuo, quién es responsable, costo en el tiempo, vida útil esperada."
