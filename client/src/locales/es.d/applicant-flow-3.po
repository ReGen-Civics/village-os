# needs-native-review: ruling 8, Ops only, QA round 5
msgctxt "applicant onboarding: startNow.button"
msgid "Start now"
msgstr "Empezar ya"

# needs-native-review: ruling 8, Ops only, QA round 5
msgctxt "applicant onboarding: startNow.ask"
msgid "Start them the day they are adopted, not on the next season's first all-hands day? Ops decides this."
msgstr "¿Empieza el día en que se adopta, y no el primer día de reunión general de la próxima temporada? Esto lo decide Ops."

# needs-native-review: ruling 8, Ops only, QA round 5
msgctxt "applicant onboarding: startNow.yes"
msgid "Start now"
msgstr "Empezar ya"

# needs-native-review: ruling 8, Ops only, QA round 5
msgctxt "applicant onboarding: startNow.keep"
msgid "Not now"
msgstr "Ahora no"

# needs-native-review: ruling 8, Ops only, QA round 5
msgctxt "applicant onboarding: startNow.chosen"
msgid "Ops chose to start now: their roles start the day they are adopted."
msgstr "Ops eligió empezar ya: sus roles empiezan el día en que se adopta."

# needs-native-review: ruling 8, Ops only, QA round 5
msgctxt "applicant onboarding: startNowDone"
msgid "Start now is already chosen."
msgstr "Empezar ya ya está elegido."

# needs-native-review: the start rule, 28 Nov 2026
msgctxt "open proposal decide: adoptedAccountOn"
msgid "Adopted. That address already has an account here, so no invitation was needed: their roles start on {day}."
msgstr "Adoptada. Esa dirección ya tiene una cuenta aquí, así que no hizo falta una invitación: sus roles empiezan el {day}."

# needs-native-review: the start rule, 28 Nov 2026
msgctxt "open proposal decide: adoptedAccountNow"
msgid "Adopted. That address already has an account here, so no invitation was needed: their roles start today, because Ops chose to start now."
msgstr "Adoptada. Esa dirección ya tiene una cuenta aquí, así que no hizo falta una invitación: sus roles empiezan hoy, porque Ops eligió empezar ya."

# needs-native-review: QA round 5
msgctxt "role progress, a measure"
msgid "Calls written up (of those booked)"
msgstr "Llamadas escritas (de las reservadas)"

# needs-native-review: QA round 5
msgctxt "role measures, holding chain"
msgid "Seated now (current holders)"
msgstr "Con rol ahora (quienes lo ocupan)"

# needs-native-review: QA round 5, references are claimed and no longer assigned
msgctxt "the bell: why a notice of this kind matters, kind application_references_in"
msgid "An applicant sent their references. Claim the ones you will follow up."
msgstr "Una persona solicitante envió sus referencias. Tome las que usted va a seguir."

# needs-native-review: QA round 5, references are claimed and no longer assigned
