# needs-native-review: the applicant's next-step card on their profile, 27 Nov 2026
msgctxt "profile: the applicant's next-step card, kicker"
msgid "Your application"
msgstr "Su postulación"

# needs-native-review: the applicant's next-step card on their profile, 27 Nov 2026
msgctxt "profile: the applicant's next-step card, link to the status page"
msgid "Open your application"
msgstr "Abrir su postulación"

# needs-native-review: the proposal stays open through the final conversation, 27 Nov 2026
msgctxt "applicant onboarding: finalAdded"
msgid "The final conversation is open. The applicant books it now, and can keep refining their proposal until the final conversation is written up."
msgstr "La conversación final está abierta. La persona que postula la reserva ahora, y puede seguir mejorando su propuesta hasta que la conversación final quede escrita."

# needs-native-review: the newcomer's first week, 27 Nov 2026
msgctxt "profile: a newcomer's first week, kicker"
msgid "Your first week"
msgstr "Su primera semana"

# needs-native-review: the newcomer's first week, 27 Nov 2026
msgctxt "profile: a newcomer's first week, heading"
msgid "Welcome. Here's how you start"
msgstr "Bienvenida, bienvenido. Así empieza"

# needs-native-review: the newcomer's first week, 27 Nov 2026
msgctxt "profile: the newcomer's buddy, with their role"
msgid "Your buddy: {0} ({1})"
msgstr "Su acompañante: {0} ({1})"

# needs-native-review: the newcomer's first week, 27 Nov 2026
msgctxt "profile: the newcomer's buddy"
msgid "Your buddy: {0}"
msgstr "Su acompañante: {0}"

# needs-native-review: the newcomer's first week, 27 Nov 2026
msgctxt "profile: the all-hands in the reader's own zone"
msgid "All-hands: {0} your time"
msgstr "Reunión general: {0}, su hora"

# needs-native-review: the newcomer's first week, 27 Nov 2026
msgctxt "profile: the all-hands video link"
msgid "Join the video call"
msgstr "Unirse a la videollamada"

# needs-native-review: the buddy in the adopt act, 27 Nov 2026
msgctxt "open proposal: the adopt act's buddy"
msgid "Their buddy for the first week"
msgstr "Su acompañante en la primera semana"

# needs-native-review: the buddy in the adopt act, 27 Nov 2026
msgctxt "open proposal: the default buddy"
msgid "Whoever holds the welcoming role (the default)"
msgstr "Quien tenga el rol de bienvenida (por defecto)"

# needs-native-review: the buddy in the adopt act, 27 Nov 2026
msgctxt "open proposal: what the buddy choice does"
msgid "Their name and role go in the start letter and on their profile."
msgstr "Su nombre y su rol van en la carta de inicio y en su perfil."

# needs-native-review: the team's references page, 27 Nov 2026
msgctxt "applicant onboarding: claimTaken"
msgid "Somebody else is following this one up."
msgstr "Otra persona está dando seguimiento a esta."

# needs-native-review: the team's references page, 27 Nov 2026
msgctxt "applicant onboarding: claim"
msgid "I'll follow up"
msgstr "Yo le doy seguimiento"

# needs-native-review: the team's references page, 27 Nov 2026
msgctxt "applicant onboarding: claimed"
msgid "It's yours. Add your notes and mark it done."
msgstr "Es suya. Agregue sus notas y márquela como hecha."

# needs-native-review: the team's references page, 27 Nov 2026
msgctxt "applicant onboarding: referencesPage"
msgid "Open the references page"
msgstr "Abrir la página de referencias"

# needs-native-review: the voice reflections between conversations, 27 Nov 2026
msgctxt "walkthrough: a voice reflection's player"
msgid "{role}'s reflection"
msgstr "Reflexión de {role}"

# needs-native-review: the voice reflections between conversations, 27 Nov 2026
msgctxt "walkthrough: play a voice reflection"
msgid "Listen to {role}'s reflection"
msgstr "Escuchar la reflexión de {role}"

# needs-native-review: the voice reflections between conversations, 27 Nov 2026
msgctxt "walkthrough: a voice reflection failed"
msgid "That recording did not open."
msgstr "Esa grabación no se abrió."

# needs-native-review: the voice reflections between conversations, 27 Nov 2026
msgctxt "walkthrough: the earlier holders' voice reflections, heading"
msgid "Before your call: listen to {roles}"
msgstr "Antes de su llamada: escuche a {roles}"

# needs-native-review: the voice reflections between conversations, 27 Nov 2026
msgctxt "walkthrough: what the reflections are"
msgid "Their voice reflections from their own conversations. Never shown to the applicant."
msgstr "Sus reflexiones de voz de sus propias conversaciones. Nunca se muestran a la persona que postula."

# needs-native-review: ruling 7 and the reference rule, 27 Nov 2026
msgctxt "applicant onboarding: primary.send_to_circle"
msgid "Send it to the anchor circle"
msgstr "Enviarla al círculo ancla"

# needs-native-review: ruling 7 and the reference rule, 27 Nov 2026
msgctxt "applicant onboarding: primary.welcome"
msgid "Welcome them"
msgstr "Darle la bienvenida"

# needs-native-review: ruling 7 and the reference rule, 27 Nov 2026
msgctxt "applicant onboarding: referencesPrivate"
msgid "Personal details of people who never signed up. Only the people who hold this application's conversations, the people who place roles and each reference's owner read them. No AI reads them. They are deleted with the application."
msgstr "Datos personales de personas que nunca se registraron. Solo los leen quienes tienen las conversaciones de esta postulación, quienes asignan roles y la persona a cargo de cada referencia. Ninguna IA los lee. Se borran con la postulación."

# needs-native-review: ruling 7 and the reference rule, 27 Nov 2026
msgctxt "applicant onboarding: sendToCircle.ask"
msgid "Send it to the anchor circle now? The proposal is fixed from that moment."
msgstr "¿La envía al círculo ancla ahora? La propuesta queda fija desde ese momento."

# needs-native-review: ruling 7 and the reference rule, 27 Nov 2026
msgctxt "applicant onboarding: sendToCircle.yes"
msgid "Send it"
msgstr "Enviarla"

# needs-native-review: ruling 7 and the reference rule, 27 Nov 2026
msgctxt "applicant onboarding: sendToCircle.keep"
msgid "Not yet"
msgstr "Todavía no"

# needs-native-review: ruling 7 and the reference rule, 27 Nov 2026
msgctxt "applicant onboarding: sendToCircle.sent"
msgid "Sent. The anchor circle has it now."
msgstr "Enviada. El círculo ancla ya la tiene."

# needs-native-review: ruling 7 and the reference rule, 27 Nov 2026
msgctxt "applicant onboarding: sendToCircle.failed"
msgid "That did not go through. Try again."
msgstr "No se envió. Inténtelo de nuevo."

# needs-native-review: ruling 7, 27 Nov 2026
msgctxt "applicant onboarding: finalAdded"
msgid "The final conversation is open. The applicant books it now, and keeps refining their proposal until they send it to the anchor circle."
msgstr "La conversación final está abierta. La persona la reserva ahora, y sigue mejorando su propuesta hasta que la envíe al círculo ancla."
