msgctxt "game variable map.contact_daily_cap, description"
msgid "The relay's outbound brake. 0 disables the contact relay entirely."
msgstr "El freno de salida del relevo. 0 desactiva por completo el relevo de contacto."

# needs-native-review: game mechanics dials, 26 Nov 2026
#: client/src/pages/gameMechanicsDialWords.ts
