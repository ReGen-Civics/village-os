#: client/src/pages/gameMechanicsDialWords.ts
msgctxt "game variable governance.weight_mode, choice token, hint"
msgid "Weight is each member's balance of the weight token when the ballot opens."
msgstr "El peso es el saldo de cada miembro de la ficha de peso cuando se abre la votación."

