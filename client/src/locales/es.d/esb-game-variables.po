# needs-native-review: game mechanics dials, 26 Nov 2026
#: client/src/pages/gameMechanicsDialWords.ts
msgctxt "game variable season_places.who, description"
msgid "Who proposes to take part in a season: each circle, which a live holder of any role in it proposes for, or each member for themselves. Places, the waitlist and seasons served are all counted in this unit."
msgstr "Quién propone participar en una temporada: cada círculo, por el que propone quien tenga vigente cualquier rol en él, o cada miembro por sí mismo. Los lugares, la lista de espera y las temporadas cumplidas se cuentan todos de esta forma."

# needs-native-review: game mechanics dials, 26 Nov 2026
#: client/src/pages/gameMechanicsDialWords.ts
msgctxt "game variable season_places.who, choice circle, label"
msgid "Each circle"
msgstr "Cada círculo"

# needs-native-review: game mechanics dials, 26 Nov 2026
#: client/src/pages/gameMechanicsDialWords.ts
msgctxt "game variable season_places.who, choice circle, hint"
msgid "A circle proposes together, and holds one place."
msgstr "Un círculo propone en conjunto y ocupa un lugar."

# needs-native-review: game mechanics dials, 26 Nov 2026
#: client/src/pages/gameMechanicsDialWords.ts
msgctxt "game variable season_places.who, choice member, label"
msgid "Each member"
