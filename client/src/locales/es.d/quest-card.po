# needs-native-review: quest card, put a quest back, 2026-11-27
msgctxt "quest page: putting a quest back failed"
msgid "That didn't go through. Try again."
msgstr "No se pudo enviar. Inténtelo de nuevo."

# needs-native-review: quest card, put a quest back, 2026-11-27
msgctxt "quest page: the ask before putting a quest back"
msgid "Put this quest back? It leaves your quests and opens for someone else."
msgstr "¿Devolver esta misión? Saldrá de sus misiones y quedará abierta para otra persona."

# needs-native-review: quest card, put a quest back, 2026-11-27
msgctxt "quest page: putting a quest back, in progress"
msgid "Putting it back…"
msgstr "Devolviéndola…"

# needs-native-review: quest card, put a quest back, 2026-11-27
msgctxt "quest page: confirm putting a quest back"
msgid "Yes, put it back"
msgstr "Sí, devolverla"

# needs-native-review: quest card, put a quest back, 2026-11-27
msgctxt "quest page: keep the quest, do not put it back"
msgid "Keep it"
msgstr "Conservarla"

# needs-native-review: quest card, put a quest back, 2026-11-27
msgctxt "quest page: let go of a quest you took"
msgid "Put this quest back"
msgstr "Devolver esta misión"

# needs-native-review: quest card, put a quest back, 2026-11-27
msgctxt "quest page: after putting a quest back"
msgid "Put back. It has left your quests and is open for someone else."
msgstr "Devuelta. Salió de sus misiones y está abierta para otra persona."

# needs-native-review: quest card, the strip for a member holding the quest, 2026-11-27
msgctxt "quest page: the strip for a member holding the quest"
msgid "You took this quest. Turn in your work when it is done, or put it back."
msgstr "Usted tomó esta misión. Entregue su trabajo cuando esté listo, o devuélvala."

# needs-native-review: quest card, the strip for a member holding the quest, 2026-11-27
msgctxt "quest page: the strip for a member whose work is turned in"
msgid "You turned this in. A steward will read it soon."
msgstr "Usted entregó esto. Un custodio lo leerá pronto."

# needs-native-review: quest card, the strip for a member holding the quest, 2026-11-27
msgctxt "quest page: jump to the member's actions on this quest"
msgid "Your next step"
msgstr "Su siguiente paso"
