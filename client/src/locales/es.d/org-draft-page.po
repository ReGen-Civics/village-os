# needs-native-review: the org chart draft page, 26 Nov 2026
msgctxt "draft page"
msgid "Put this draft to the village? A vote opens, and the village decides it."
msgstr "¿Llevar este borrador a la aldea? Se abre una votación, y la aldea lo decide."

# needs-native-review: the org chart draft page, 26 Nov 2026
msgctxt "draft page"
msgid "Copy link"
msgstr "Copiar enlace"

# needs-native-review: the org chart draft page, 26 Nov 2026
msgctxt "draft page"
msgid "There is no draft at this address that you can read. Drafts are read by whoever may decide the org chart and by the person who made them."
msgstr "No hay en esta dirección un borrador que usted pueda leer. Los borradores los leen quienes pueden decidir el organigrama y la persona que los hizo."

