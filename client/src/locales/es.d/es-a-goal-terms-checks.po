# needs-native-review: goals and terms checks, usted, 2026-11-27
msgctxt "role goals: check"
msgid "Send your goals as a list."
msgstr "Envíe sus metas como una lista."

# needs-native-review: goals and terms checks, usted, 2026-11-27
msgctxt "role goals: check"
msgid "Add at least one goal for your first moon."
msgstr "Agregue al menos una meta para su primera luna."

# needs-native-review: goals and terms checks, usted, 2026-11-27
msgctxt "role goals: check"
msgid "Up to {max} goals for a role."
msgstr "Hasta {max} metas por rol."

# needs-native-review: goals and terms checks, usted, 2026-11-27
msgctxt "role goals: check"
msgid "One of your goals could not be read."
msgstr "No se pudo leer una de sus metas."

# needs-native-review: goals and terms checks, usted, 2026-11-27
msgctxt "role goals: check"
msgid "Name goal {n}."
msgstr "Ponga nombre a la meta {n}."

# needs-native-review: goals and terms checks, usted, 2026-11-27
msgctxt "role goals: check"
msgid "Say when goal {n} is done."
msgstr "Diga cuándo queda cumplida la meta {n}."

# needs-native-review: goals and terms checks, usted, 2026-11-27
msgctxt "role goals: check"
msgid "A goal is too long. Keep it under {n} characters."
msgstr "Una meta es demasiado larga. Manténgala por debajo de {n} caracteres."

# needs-native-review: goals and terms checks, usted, 2026-11-27
msgctxt "role goals: check"
msgid "Done when is too long. Keep it under {n} characters."
msgstr "\"Cumplida cuando\" es demasiado largo. Manténgalo por debajo de {n} caracteres."

# needs-native-review: goals and terms checks, usted, 2026-11-27
msgctxt "role goals: check"
msgid "{what} is too long. Keep it under {n} characters."
msgstr "{what}: es demasiado largo. Manténgalo por debajo de {n} caracteres."

# needs-native-review: goals and terms checks, usted, 2026-11-27
msgctxt "role goals: check"
msgid "Goal {n} moves a goal this role does not have. Pick one from the role's own goals."
msgstr "La meta {n} avanza una meta que este rol no tiene. Elija una de las metas propias del rol."

# needs-native-review: goals and terms checks, usted, 2026-11-27
msgctxt "role goals: check"
msgid "Goal {n} names a season goal this season does not have."
msgstr "La meta {n} nombra una meta de temporada que esta temporada no tiene."

# needs-native-review: goals and terms checks, usted, 2026-11-27
msgctxt "role goals: check"
msgid "Write the date for goal {n} as a day, like 2026-11-16."
msgstr "Escriba la fecha de la meta {n} como un día, por ejemplo 2026-11-16."

# needs-native-review: goals and terms checks, usted, 2026-11-27
msgctxt "role goals: check"
msgid "The date for goal {n} falls outside this moon."
msgstr "La fecha de la meta {n} queda fuera de esta luna."

# needs-native-review: goals and terms checks, usted, 2026-11-27
msgctxt "role goals: check"
msgid "Goal {n} names a role that is not in this proposal."
msgstr "La meta {n} nombra un rol que no está en esta propuesta."

# needs-native-review: goals and terms checks, usted, 2026-11-27
msgctxt "role terms: a setting a check names"
msgid "Term"
msgstr "Plazo"

# needs-native-review: goals and terms checks, usted, 2026-11-27
msgctxt "role terms: a setting a check names"
msgid "Clocks"
msgstr "Tiempo"

# needs-native-review: goals and terms checks, usted, 2026-11-27
msgctxt "role terms: a setting a check names"
msgid "Rhythm"
msgstr "Ritmo"

# needs-native-review: goals and terms checks, usted, 2026-11-27
msgctxt "role terms: a setting a check names"
msgid "Allowance"
msgstr "Asignación"

# needs-native-review: goals and terms checks, usted, 2026-11-27
msgctxt "role terms: a setting a check names"
msgid "Bonus"
msgstr "Bono"

# needs-native-review: goals and terms checks, usted, 2026-11-27
msgctxt "role terms: a setting a check names"
msgid "Goals"
msgstr "Metas"

# needs-native-review: goals and terms checks, usted, 2026-11-27
msgctxt "role terms: a setting a check names"
msgid "Scoreboard"
msgstr "Marcador"

# needs-native-review: goals and terms checks, usted, 2026-11-27
msgctxt "role terms: a setting a check names"
msgid "Ending"
msgstr "Cierre"

# needs-native-review: goals and terms checks, usted, 2026-11-27
msgctxt "role terms: check"
msgid "Say whether you accept or would like to talk about {label}."
msgstr "{label}: diga si lo acepta o si prefiere conversarlo."

# needs-native-review: goals and terms checks, usted, 2026-11-27
msgctxt "role terms: check"
msgid "Keep your note on {label} to {max} characters."
msgstr "Mantenga su nota sobre {label} en {max} caracteres como máximo."

# needs-native-review: goals and terms checks, usted, 2026-11-27
msgctxt "role terms: check"
msgid "Choose your commitment, from 0 to 100 in steps of 10."
msgstr "Elija su compromiso, de 0 a 100 en pasos de 10."
